# Godot 4+ specific ignores
.godot/
/android/

# Godot editor cache
.godot/

# Privately sourced British infantry asset: keep local, never commit vendor FBX/GLBs.
/assets/characters/player_british/*.glb
/assets/characters/player_british/*.fbx
/assets/characters/player_british/*.Fbx

# Licensed third-party BAMEN FPS rigged hands installed locally from separate ZIP.
/assets/characters/bamen_fps_arms/*.glb

# Poly Haven CC0 1K material downloads installed locally by tool.
/assets/environment/remaster/textures/*.jpg
/assets/environment/remaster/textures/*.png

# Large third-party character and weapon binaries remain local. Confirm licenses before distribution.
/assets/characters/panzergrenadier/*.glb
/assets/weapons/lee_enfield/*.glb
/assets/weapons/sniper/*.glb
/assets/environment/remaster/models/*.glb

# Art installed from licensed archives remains local; do not publish third-party meshes.
/assets/remaster_imported/
